# ============================================================================
# CIV-CON Backend — Environment Configuration Example
# ============================================================================
# Copy this file to `.env` and fill in real values for your local environment.
# NEVER commit a real `.env` file to version control.
#
# All values below MUST be supplied as environment variables in production
# (Render, Railway, Fly, etc.). Use the platform's secret manager.
# ============================================================================

# ----- Database (PostgreSQL via asyncpg) -----
# Local example:
#   DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/civcon
# Production example (Render):
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/DB?sslmode=require
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@localhost:5432/civcon

# Discrete fields (used to compose DATABASE_URL; do not commit real values)
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_NAME=civcon
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME

# ----- Database connection pool -----
# All four values are optional; defaults are applied in app/config.py if
# the env var is omitted. Tune per environment based on the database
# server's max_connections limit and the app's concurrency.
#
# DB_POOL_SIZE       — persistent connections kept open (default 10)
# DB_MAX_OVERFLOW    — extra connections allowed beyond pool_size under
#                      load (default 20; total ceiling = pool + overflow)
# DB_POOL_RECYCLE    — seconds before a connection is recycled; keep
#                      below any cloud LB / pgbouncer idle timeout
#                      (default 1800 = 30 min)
# DB_POOL_TIMEOUT    — seconds to wait for a free connection before
#                      raising QueuePoolTimeout (default 30)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ----- API runtime -----
# REQUEST_TIMEOUT_SECONDS — per-request processing budget enforced by
#   RequestTimeoutMiddleware; requests that exceed it are answered with
#   a 504. WebSockets are exempt.
# MAX_REQUEST_BODY_BYTES — Content-Length ceiling enforced by
#   RequestSizeLimitMiddleware; oversize requests are answered with a
#   413. Default 10 MiB.
# LOG_FORMAT — "json" for production, "text" for local dev. JSON is
#   the recommended setting so the platform log shipper can index
#   per-request fields (method, path, status, duration_ms, request_id).
# LOG_LEVEL — standard logging level (DEBUG, INFO, WARNING, ERROR).
# SLOW_REQUEST_THRESHOLD_MS — when a request takes longer than this
#   many ms, AccessLogMiddleware emits a separate WARNING log line in
#   addition to the normal access log. Useful for alerting.
# METRICS_ENABLED — toggle the Prometheus /metrics endpoint.
REQUEST_TIMEOUT_SECONDS=30
MAX_REQUEST_BODY_BYTES=10485760
LOG_FORMAT=text
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=1000
METRICS_ENABLED=true

# Set to "true" on Render to skip local-only initialisation paths
RENDER=false

# ----- Runtime environment -----
# ENVIRONMENT — surfaced in Sentry events, /health responses, and
#   access logs. Use "production", "staging", or "development".
# APP_VERSION — surfaced to Sentry as the release tag and the
#   FastAPI app version. Should match the deploy tag.
ENVIRONMENT=development
APP_VERSION=1.0.0

# ----- Sentry (backend error tracking) -----
# SENTRY_DSN — leave EMPTY to disable error tracking entirely. The
#   app will run with no Sentry overhead.
# SENTRY_ENVIRONMENT — overrides the value sent to Sentry as the
#   environment tag. Defaults to ENVIRONMENT.
# SENTRY_TRACES_SAMPLE_RATE — fraction of transactions to capture
#   as performance traces. 0.0 = off, 1.0 = every request. 0.1 is
#   a reasonable production setting.
# SENTRY_PROFILES_SAMPLE_RATE — fraction of transactions to
#   profile. Requires a Sentry plan that supports profiling.
# SENTRY_SEND_DEFAULT_PII — set to "true" to include IP addresses
#   and user identifiers in Sentry events. Default "false" to
#   keep PII out of the error tracker.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# ----- Security / JWT -----
# Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
SESSION_SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- Google OAuth -----
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ----- LinkedIn OAuth -----
# https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=CHANGE_ME
LINKEDIN_CLIENT_SECRET=CHANGE_ME
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# ----- Africa's Talking (USSD + SMS) -----
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=CHANGE_ME
LIVE_USERNAME=sandbox
LIVE_API_KEY=CHANGE_ME
DEFAULT_CIVIC_OFFICE_NUMBER=+256700000000

# ----- Email (FastMail SMTP) -----
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=CHANGE_ME
MAIL_SERVER=smtp.fastmail.com
MAIL_PORT=587
MAIL_TLS=True
MAIL_SSL=False

# ----- Redis (Upstash or self-hosted) -----
# Example: rediss://default:<PASSWORD>@<HOST>.upstash.io:6379
REDIS_URL=CHANGE_ME

# ----- Cloudinary -----
cloudinary_cloud_name=CHANGE_ME
cloudinary_api_key=CHANGE_ME
cloudinary_api_secret=CHANGE_ME

# ----- Resend Email Service -----
RESEND_API_KEY=CHANGE_ME
SENDER_EMAIL=CIV-CON <no-reply@example.com>

# ----- Frontend / Backend URLs (used in OAuth callbacks and CORS) -----
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ----- Test / Dev fallbacks -----
FALLBACK_PHONE=+256700000000
FALLBACK_MP_ID=1
